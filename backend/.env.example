# Copy to .env and fill in real values. Everything below has a safe default
# for local development except the keys explicitly marked "required for...".

# --- Security ---
CYBERTRACE_SECRET_KEY=replace-with-a-long-random-string-in-production

# --- Database ---
# Default: local SQLite file, zero setup.
# For Postgres: postgresql+psycopg2://user:password@host:5432/cybertrace
DATABASE_URL=sqlite:///./cybertrace.db

# --- Background jobs (Celery + Redis) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Threat Intelligence providers (replace SAMPLE_KEY with your real key) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
# URLhaus needs no key — it's active by default.

# --- AI Investigation Copilot ---
# Google Gemini is used first when GOOGLE_API_KEY is configured.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash

# ChatGPT is used next when Google is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Claude is the optional final fallback.
ANTHROPIC_API_KEY=
